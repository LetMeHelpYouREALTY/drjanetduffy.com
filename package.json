{
  "name": "drjanetduffy.com",
  "version": "1.0.0",
  "description": "Dr. Janet Duffy's professional website",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf .next dist build",
    "pre-commit": "biome check --write . && tsc --noEmit",
    "deploy": "node scripts/deploy.js",
    "deploy:skip-checks": "node scripts/deploy.js --skip-checks",
    "deploy:checks-only": "node scripts/deploy.js --skip-deploy",
    "vercel:build": "next build",
    "vercel:dev": "next dev",
    "postinstall": "next telemetry disable"
  },
  "dependencies": {
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tailwindcss": "^3.4.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.400.0",
    "react-hook-form": "^7.50.0",
    "@hookform/resolvers": "^3.3.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "packageManager": "npm@10.8.0"
}
